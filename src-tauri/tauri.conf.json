{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nusic Studio",
  "version": "0.1.0",
  "identifier": "com.peanutgt.nusicstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nusic Studio",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "TradChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Local AI music studio",
    "resources": [
      "resources/ace_worker.py"
    ]
  }
}
